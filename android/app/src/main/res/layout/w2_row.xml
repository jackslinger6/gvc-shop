<?xml version="1.0" encoding="utf-8"?>
<!-- one item in the widget's list: colour bar, tag, title (up to 2 lines), where it is. The whole row opens it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r2_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:background="@drawable/w2_card_dark">
    <ImageView
        android:id="@+id/r2_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#8E96A3"
        android:contentDescription="@null"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/r2_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/r2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ECEBE8"
            android:maxLines="2"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/r2_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#A9AFB7"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
