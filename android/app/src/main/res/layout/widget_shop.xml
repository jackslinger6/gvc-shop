<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GORDEYVILLE CUSTOMS"
                android:textColor="#FFE4DED6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"/>
            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF9AA0A8"
                android:textSize="11sp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/refresh"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#FFE9E6E1"
            android:textSize="20sp"/>
        <TextView
            android:id="@+id/open"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="@drawable/widget_tab_off"
            android:text="Open"
            android:textColor="#FFFFB070"
            android:textStyle="bold"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tab_pipeline"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:gravity="center"
            android:background="@drawable/widget_tab_off"
            android:text="Pipeline"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#FF9AA0A8"/>
        <TextView
            android:id="@+id/tab_orders"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:gravity="center"
            android:background="@drawable/widget_tab_on"
            android:text="Orders"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#FFFFFFFF"/>
        <TextView
            android:id="@+id/tab_shop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_tab_off"
            android:text="Shop floor"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#FF9AA0A8"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"/>
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Loading the board…"
            android:textColor="#FF9AA0A8"
            android:textSize="13sp"/>
    </FrameLayout>
</LinearLayout>
