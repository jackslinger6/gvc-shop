<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, styled like the app (dark, orange accents, condensed caps) - Nov 4 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/title_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GVC VAULT"
                android:fontFamily="sans-serif-condensed"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>
            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GORDEYVILLE CUSTOMS"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:textColor="#FFFFB36B"
                android:textSize="10sp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/rec"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="6dp"
            android:gravity="center"
            android:paddingLeft="11dp"
            android:paddingRight="11dp"
            android:background="@drawable/widget_btn_rec"
            android:text="● REC"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:textColor="#FFFF6B5E"
            android:textStyle="bold"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="6dp"
            android:gravity="center"
            android:background="@drawable/widget_btn_round"
            android:text="⟳"
            android:textColor="#FFE9E6E1"
            android:textSize="17sp"/>
        <TextView
            android:id="@+id/open"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingLeft="13dp"
            android:paddingRight="13dp"
            android:background="@drawable/widget_btn_orange"
            android:text="OPEN"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:textColor="#FF111111"
            android:textStyle="bold"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tab_todo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:background="@drawable/widget_tab_off"
            android:text="To do"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textSize="12.5sp"
            android:textColor="#FF9AA0A8"/>
        <TextView
            android:id="@+id/tab_pipeline"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:background="@drawable/widget_tab_off"
            android:text="Pipeline"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textSize="12.5sp"
            android:textColor="#FF9AA0A8"/>
        <TextView
            android:id="@+id/tab_orders"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:background="@drawable/widget_tab_off"
            android:text="Orders"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textSize="12.5sp"
            android:textColor="#FF9AA0A8"/>
        <TextView
            android:id="@+id/tab_shop"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            
            android:gravity="center"
            android:background="@drawable/widget_tab_off"
            android:text="Shop"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textSize="12.5sp"
            android:textColor="#FF9AA0A8"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"/>
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Loading the board…"
            android:textColor="#FF9AA0A8"
            android:textSize="13sp"/>
    </FrameLayout>
</LinearLayout>
