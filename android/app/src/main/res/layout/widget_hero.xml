<?xml version="1.0" encoding="utf-8"?>
<!-- First "Next up" card on the widget, like the big card on the app's Home (Nov 4) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/x_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="13dp"
    android:background="@drawable/widget_hero_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/x_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="#FF111111"
            android:textSize="11sp"/>
        <TextView
            android:id="@+id/x_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.14"
            android:textColor="#FF9AA0A8"
            android:textSize="10.5sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/x_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"/>
    <TextView
        android:id="@+id/x_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFC9CED6"
        android:textSize="12.5sp"/>
    <TextView
        android:id="@+id/x_go"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:background="@drawable/widget_btn_orange"
        android:text="OPEN"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textColor="#FF111111"
        android:textSize="14sp"/>
</LinearLayout>
