<?xml version="1.0" encoding="utf-8"?>
<!-- Widget, short and wide (e.g. 4 x 2 cells): the one thing to do now on the left, its button on the right;
     Record and Refresh only when there's room for them at full size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/w2_bg_dark">
    <LinearLayout
        android:id="@+id/w_hero"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/w_hero_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:background="@drawable/w2_tag_dark"/>
            <TextView
                android:id="@+id/w_status"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="#A9AFB7"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
        <TextView
            android:id="@+id/w_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ECEBE8"
            android:maxLines="2"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/w_hero_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#A9AFB7"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:gravity="end">
        <TextView
            android:id="@+id/w_act1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="96dp"
            android:maxWidth="150dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1B0F05"
            android:maxLines="2"
            android:ellipsize="end"
            android:background="@drawable/w2_btn1_dark"/>
        <LinearLayout
            android:id="@+id/w_hdr_acts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/w_rec"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/w2_btn2_dark">
                <ImageView
                    android:id="@+id/w_rec_i"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_w2_mic"
                    android:contentDescription="@null"/>
                <TextView
                    android:id="@+id/w_rec_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#ECEBE8"
                    android:maxLines="1"
                    android:visibility="gone"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/w_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/w2_btn2_dark"
                android:contentDescription="Refresh">
                <ImageView
                    android:id="@+id/w_refresh_i"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w2_refresh"
                    android:contentDescription="@null"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
