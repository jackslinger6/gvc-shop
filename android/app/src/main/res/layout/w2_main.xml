<?xml version="1.0" encoding="utf-8"?>
<!-- Widget, medium and large (redesign Nov 15): header (brand + sync status, Retry, Record, Refresh), the one thing
     to do now (hero card, or the crew timer), the rest as a scrolling list, and the role's destinations.
     Colours and backgrounds are set from code for the app's appearance (dark / light / girly). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/w2_bg_dark">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/w_brand"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="6dp">
            <TextView
                android:id="@+id/w_brand_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GVC Vault"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ECEBE8"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/w_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#A9AFB7"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
        <TextView
            android:id="@+id/w_retry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="4dp"
            android:text="Retry"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#ECEBE8"
            android:background="@drawable/w2_btn2_dark"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/w_rec"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/w2_btn2_dark">
            <ImageView
                android:id="@+id/w_rec_i"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_w2_mic"
                android:contentDescription="@null"/>
            <TextView
                android:id="@+id/w_rec_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Record"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ECEBE8"
                android:maxLines="1"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/w_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/w2_btn2_dark"
            android:contentDescription="Refresh">
            <ImageView
                android:id="@+id/w_refresh_i"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_w2_refresh"
                android:contentDescription="@null"/>
        </FrameLayout>
    </LinearLayout>

    <!-- the one thing to do now -->
    <LinearLayout
        android:id="@+id/w_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:background="@drawable/w2_card_dark">
        <ImageView
            android:id="@+id/w_hero_bar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="#FF8A2A"
            android:contentDescription="@null"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/w_hero_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:background="@drawable/w2_tag_dark"/>
                <TextView
                    android:id="@+id/w_hero_count"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="#A9AFB7"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
            <TextView
                android:id="@+id/w_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ECEBE8"
                android:maxLines="2"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/w_hero_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="#A9AFB7"
                android:maxLines="1"
                android:ellipsize="end"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/w_act1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#1B0F05"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:background="@drawable/w2_btn1_dark"/>
                <TextView
                    android:id="@+id/w_act2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#ECEBE8"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:background="@drawable/w2_btn2_dark"
                    android:visibility="gone"/>
            </LinearLayout>
            <!-- narrow widgets: the second button goes under the first instead of beside it -->
            <TextView
                android:id="@+id/w_act2b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#ECEBE8"
                android:maxLines="2"
                android:ellipsize="end"
                android:background="@drawable/w2_btn2_dark"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <!-- medium size: one line with the next item instead of a list -->
    <TextView
        android:id="@+id/w_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:textColor="#ECEBE8"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/w2_card_dark"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/w_list_h"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="4dp"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#A9AFB7"
        android:maxLines="1"/>
    <ListView
        android:id="@+id/w_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"/>
    <TextView
        android:id="@+id/w_none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textSize="13sp"
        android:textColor="#A9AFB7"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/w_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_nav0" style="@style/W2Nav" android:layout_marginStart="0dp"/>
        <TextView android:id="@+id/w_nav1" style="@style/W2Nav"/>
        <TextView android:id="@+id/w_nav2" style="@style/W2Nav"/>
        <TextView android:id="@+id/w_nav3" style="@style/W2Nav"/>
    </LinearLayout>
</LinearLayout>
